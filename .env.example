# Copy to .env and fill in. .env is gitignored and is never baked into the
# Docker image; docker/run.sh passes it through with --env-file.

# Required for gpt-* models (reasoning, neighbor filtering, QA, key extraction).
OPENAI_API_KEY=

# Only needed for gemini-* models.
GOOGLE_API_KEY=
# Only needed for vertex-gemini-* models (falls back to GOOGLE_API_KEY).
VERTEX_API_KEY=

# Only needed if your Hugging Face account gates any of the model weights.
HF_TOKEN=
